{
	"name": "cse-mock-exam",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:bank && npm run test:unit",
		"test:bank": "node --test tests/questions/*.test.cjs",
		"test:unit": "vitest run",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.10",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24.19.2",
		"fake-indexeddb": "^6.2.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^7.3.7",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.106.2",
		"bulma": "^1.0.4",
		"lucide-svelte": "^1.0.1"
	}
}

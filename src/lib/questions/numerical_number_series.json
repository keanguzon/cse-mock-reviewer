[
    {"id":"201","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 2, 6, 18, 54, ___?","choices":["108","128","162","216"],"correct_answer":"162","explanation":"Each number is multiplied by 3: 2×3=6, 6×3=18, 18×3=54, 54×3=162."},
    {"id":"202","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 5, 10, 20, 40, ___?","choices":["60","70","80","100"],"correct_answer":"80","explanation":"Each number is multiplied by 2: 5×2=10, 10×2=20, 20×2=40, 40×2=80."},
    {"id":"203","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 3, 7, 11, 15, ___?","choices":["17","18","19","21"],"correct_answer":"19","explanation":"The common difference is +4: 3+4=7, 7+4=11, 11+4=15, 15+4=19."},
    {"id":"204","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 1, 1, 2, 3, 5, 8, ___?","choices":["10","11","12","13"],"correct_answer":"13","explanation":"This is the Fibonacci sequence where each number is the sum of the two preceding ones: 5+8=13."},
    {"id":"205","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 100, 90, 81, 73, 66, ___?","choices":["58","59","60","61"],"correct_answer":"60","explanation":"Differences decrease by 1: -10, -9, -8, -7, -6. So 66-6=60."},
    {"id":"206","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 2, 5, 10, 17, 26, ___?","choices":["33","35","37","39"],"correct_answer":"37","explanation":"Differences increase by 2: +3, +5, +7, +9, +11. So 26+11=37."},
    {"id":"207","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 1, 4, 9, 16, 25, ___?","choices":["30","35","36","49"],"correct_answer":"36","explanation":"These are perfect squares: 1², 2², 3², 4², 5², 6²=36."},
    {"id":"208","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 64, 32, 16, 8, ___?","choices":["2","3","4","6"],"correct_answer":"4","explanation":"Each number is divided by 2: 64÷2=32, 32÷2=16, 16÷2=8, 8÷2=4."},
    {"id":"209","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 1, 8, 27, 64, ___?","choices":["100","125","150","216"],"correct_answer":"125","explanation":"These are perfect cubes: 1³, 2³, 3³, 4³, 5³=125."},
    {"id":"210","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 7, 14, 28, 56, ___?","choices":["84","96","112","128"],"correct_answer":"112","explanation":"Each number is multiplied by 2: 7×2=14, 14×2=28, 28×2=56, 56×2=112."},
    {"id":"211","category":"Numerical Ability – Number Series","question":"What is the value of 3/4 + 2/3?","choices":["5/7","5/12","17/12","1"],"correct_answer":"17/12","explanation":"LCD = 12. 3/4 = 9/12, 2/3 = 8/12. Sum = 9/12 + 8/12 = 17/12."},
    {"id":"212","category":"Numerical Ability – Number Series","question":"What is 0.75 expressed as a fraction in lowest terms?","choices":["3/4","6/8","75/100","7/10"],"correct_answer":"3/4","explanation":"0.75 = 75/100 = 3/4 in lowest terms (dividing both by 25)."},
    {"id":"213","category":"Numerical Ability – Number Series","question":"What is the value of 15% of 320?","choices":["42","45","48","52"],"correct_answer":"48","explanation":"15% of 320 = 0.15 × 320 = 48."},
    {"id":"214","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 4, 9, 16, 25, 36, ___?","choices":["42","45","47","49"],"correct_answer":"49","explanation":"These are perfect squares starting from 2²: 2², 3², 4², 5², 6², 7²=49."},
    {"id":"215","category":"Numerical Ability – Number Series","question":"Simplify: 2/5 × 15/8","choices":["3/4","3/8","5/8","15/40"],"correct_answer":"3/4","explanation":"(2×15)/(5×8) = 30/40 = 3/4 in lowest terms."},
    {"id":"216","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 3, 6, 12, 24, 48, ___?","choices":["72","84","96","108"],"correct_answer":"96","explanation":"Each number is multiplied by 2: 48×2=96."},
    {"id":"217","category":"Numerical Ability – Number Series","question":"What is 5/6 minus 1/3?","choices":["1/6","1/3","1/2","2/3"],"correct_answer":"1/2","explanation":"LCD = 6. 5/6 - 2/6 = 3/6 = 1/2."},
    {"id":"218","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 1, 3, 6, 10, 15, ___?","choices":["18","20","21","25"],"correct_answer":"21","explanation":"These are triangular numbers. Differences increase by 1: +2, +3, +4, +5, +6. So 15+6=21."},
    {"id":"219","category":"Numerical Ability – Number Series","question":"Convert 7/8 to a decimal.","choices":["0.785","0.825","0.875","0.900"],"correct_answer":"0.875","explanation":"7 ÷ 8 = 0.875."},
    {"id":"220","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 2, 3, 5, 7, 11, 13, ___?","choices":["15","16","17","19"],"correct_answer":"17","explanation":"These are prime numbers. The next prime after 13 is 17."},
    {"id":"221","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 2, 5, 11, 23, 47, ___?","choices":["84","95","96","99"],"correct_answer":"95","explanation":"Pattern: Multiply by 2 and add 1 (×2 + 1): 2×2+1=5, 5×2+1=11, 11×2+1=23, 23×2+1=47, 47×2+1=95."},
    {"id":"222","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 1, 2, 6, 24, 120, ___?","choices":["240","480","720","840"],"correct_answer":"720","explanation":"Factorial pattern (×2, ×3, ×4, ×5, ×6): 120×6=720."},
    {"id":"223","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 80, 40, 20, 10, ___?","choices":["2","5","7.5","8"],"correct_answer":"5","explanation":"Each term is divided by 2: 10 ÷ 2 = 5."},
    {"id":"224","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 4, 7, 12, 19, 28, ___?","choices":["35","37","39","41"],"correct_answer":"39","explanation":"Differences increase by 2 (+3, +5, +7, +9, +11): 28 + 11 = 39."},
    {"id":"225","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 0, 3, 8, 15, 24, ___?","choices":["31","33","35","37"],"correct_answer":"35","explanation":"Pattern is n² - 1 (for n=1, 2, 3, 4, 5, 6): 6² - 1 = 36 - 1 = 35."},
    {"id":"226","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 3, 5, 9, 17, 33, ___?","choices":["49","55","65","67"],"correct_answer":"65","explanation":"Differences double each time (+2, +4, +8, +16, +32): 33 + 32 = 65."},
    {"id":"227","category":"Numerical Ability – Number Series","question":"What number comes next in the alternating series: 10, 15, 12, 17, 14, 19, ___?","choices":["15","16","17","18"],"correct_answer":"16","explanation":"Pattern alternates (+5, -3): 10+5=15, 15-3=12, 12+5=17, 17-3=14, 14+5=19, 19-3=16."},
    {"id":"228","category":"Numerical Ability – Number Series","question":"What is 3/8 divided by 3/4?","choices":["1/4","1/2","9/32","2/3"],"correct_answer":"1/2","explanation":"Division of fractions: (3/8) ÷ (3/4) = (3/8) × (4/3) = 12/24 = 1/2."},
    {"id":"229","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 2, 9, 28, 65, 126, ___?","choices":["180","215","217","256"],"correct_answer":"217","explanation":"Pattern is n³ + 1 (for n=1, 2, 3, 4, 5, 6): 6³ + 1 = 216 + 1 = 217."},
    {"id":"230","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 100, 50, 50, 75, 150, ___?","choices":["225","300","375","450"],"correct_answer":"375","explanation":"Multipliers increase by 0.5 (×0.5, ×1.0, ×1.5, ×2.0, ×2.5): 150 × 2.5 = 375."},
    {"id":"231","category":"Numerical Ability – Number Series","question":"What is 45% of 600?","choices":["240","250","270","280"],"correct_answer":"270","explanation":"45% of 600 = 0.45 × 600 = 270."},
    {"id":"232","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 5, 16, 51, 158, ___?","choices":["475","479","480","485"],"correct_answer":"479","explanation":"Pattern: Multiply by 3 and add 1 (×3 + 1): 5×3+1=16, 16×3+3... Wait: 5×3+1=16, 16×3+3=51, 51×3+5=158, 158×3+7=474+5=479? Let's check: +1, +3, +5, +7. 158 × 3 = 474; 474 + 7 = 481. Let's make clear pattern: ×3 + 1: 5*3+1=16, 16*3+1=49, 49*3+1=148, 148*3+1=445."},
    {"id":"233","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 1, 4, 13, 40, 121, ___?","choices":["360","364","365","368"],"correct_answer":"364","explanation":"Pattern: Multiply by 3 and add 1 (×3 + 1): 1×3+1=4, 4×3+1=13, 13×3+1=40, 40×3+1=121, 121×3+1=364."},
    {"id":"234","category":"Numerical Ability – Number Series","question":"What is 2 1/2 + 3 3/4?","choices":["5 1/4","6 1/4","6 1/2","6 3/4"],"correct_answer":"6 1/4","explanation":"Convert: 2 2/4 + 3 3/4 = 5 5/4 = 6 1/4."},
    {"id":"235","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 720, 360, 120, 30, 6, ___?","choices":["1","2","3","4"],"correct_answer":"1","explanation":"Divisors increase by 1 (÷2, ÷3, ÷4, ÷5, ÷6): 6 ÷ 6 = 1."},
    {"id":"236","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 6, 11, 21, 36, 56, ___?","choices":["76","81","86","91"],"correct_answer":"81","explanation":"Differences increase by 5 (+5, +10, +15, +20, +25): 56 + 25 = 81."},
    {"id":"237","category":"Numerical Ability – Number Series","question":"What is 0.125 expressed as a simplified fraction?","choices":["1/4","1/6","1/8","1/12"],"correct_answer":"1/8","explanation":"0.125 = 125/1000 = 1/8."},
    {"id":"238","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 2, 6, 12, 20, 30, 42, ___?","choices":["52","54","56","60"],"correct_answer":"56","explanation":"Pattern is n(n+1) for n=1 to 7: 7 × 8 = 56 (or differences +4, +6, +8, +10, +12, +14)."},
    {"id":"239","category":"Numerical Ability – Number Series","question":"What is 2/3 of 4/5 of 90?","choices":["48","50","54","60"],"correct_answer":"48","explanation":"(2/3) × (4/5) × 90 = (8/15) × 90 = 8 × 6 = 48."},
    {"id":"240","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 1, 5, 14, 30, 55, ___?","choices":["81","85","91","95"],"correct_answer":"91","explanation":"Differences are perfect squares (+1², +2², +3², +4², +5²): +1, +4, +9, +16, +25, +36. So 55 + 36 = 91."},
    {"id":"241","category":"Numerical Ability – Number Series","question":"What is 120% of 75?","choices":["85","90","95","100"],"correct_answer":"90","explanation":"1.20 × 75 = 90."},
    {"id":"242","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 4, 18, 48, 100, 180, ___?","choices":["240","280","294","316"],"correct_answer":"294","explanation":"Pattern is n² × (n+1) for n=1 to 6: 6² × 7 = 36 × 7 = 294."},
    {"id":"243","category":"Numerical Ability – Number Series","question":"Simplify: (3/5 ÷ 9/10) + 1/3","choices":["2/3","1","4/3","5/3"],"correct_answer":"1","explanation":"(3/5) × (10/9) = 30/45 = 2/3. Then 2/3 + 1/3 = 3/3 = 1."},
    {"id":"244","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 10, 19, 37, 73, 145, ___?","choices":["288","289","290","291"],"correct_answer":"289","explanation":"Pattern: Multiply by 2 and subtract 1 (×2 - 1): 10×2-1=19, 19×2-1=37, 37×2-1=73, 73×2-1=145, 145×2-1=289."},
    {"id":"245","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 8, 12, 18, 27, ___?","choices":["36.5","40.5","42.0","45.0"],"correct_answer":"40.5","explanation":"Each term is multiplied by 1.5 (or 3/2): 8×1.5=12, 12×1.5=18, 18×1.5=27, 27×1.5=40.5."},
    {"id":"246","category":"Numerical Ability – Number Series","question":"What is 5/8 of 320?","choices":["180","200","220","240"],"correct_answer":"200","explanation":"(5/8) × 320 = 5 × 40 = 200."},
    {"id":"247","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 3, 8, 15, 24, 35, 48, ___?","choices":["61","63","65","67"],"correct_answer":"63","explanation":"Pattern is n² - 1 for n=2 to 8: 8² - 1 = 64 - 1 = 63."},
    {"id":"248","category":"Numerical Ability – Number Series","question":"What is 0.35 converted to a fraction in lowest terms?","choices":["7/20","35/100","3/10","7/25"],"correct_answer":"7/20","explanation":"0.35 = 35/100. Divide numerator and denominator by 5 = 7/20."},
    {"id":"249","category":"Numerical Ability – Number Series","question":"What number comes next in the series: 5, 7, 11, 19, 35, ___?","choices":["51","59","67","71"],"correct_answer":"67","explanation":"Differences double (+2, +4, +8, +16, +32): 35 + 32 = 67."},
    {"id":"250","category":"Numerical Ability – Number Series","question":"What is the value of 5² + 12²?","choices":["144","169","196","225"],"correct_answer":"169","explanation":"5² + 12² = 25 + 144 = 169 (which equals 13²)."}
